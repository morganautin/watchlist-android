<resources>
    <!--
      Thème Material 3 en mode clair. "DayNight" : Android bascule automatiquement
      sur values-night/themes.xml en mode sombre (préférence de thème à l'étape 4).
      Chaque attribut "color..." colore les composants Material (boutons, chips, FAB…).
    -->
    <style name="Theme.WatchList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/night_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/gold_light</item>
        <item name="colorOnPrimaryContainer">@color/night_blue</item>
        <item name="colorSecondary">@color/cinema_gold</item>
        <item name="colorOnSecondary">@color/night_blue</item>
        <item name="colorSecondaryContainer">@color/gold_light</item>
        <item name="colorOnSecondaryContainer">@color/night_blue</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
    </style>
</resources>
