<resources>
    <!-- Thème en mode sombre : l'or devient la couleur principale (lisible sur fond sombre). -->
    <style name="Theme.WatchList" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cinema_gold</item>
        <item name="colorOnPrimary">@color/night_blue</item>
        <item name="colorPrimaryContainer">@color/night_blue</item>
        <item name="colorOnPrimaryContainer">@color/gold_light</item>
        <item name="colorSecondary">@color/cinema_gold</item>
        <item name="colorOnSecondary">@color/night_blue</item>
        <item name="colorSecondaryContainer">#3A3420</item>
        <item name="colorOnSecondaryContainer">@color/gold_light</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
    </style>
</resources>
